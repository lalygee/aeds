#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

//entrada linha | saida coluna

//tbm para não orientado
int grauEntrada(int node1, int **matrix, int vertices){
    
    int grau = 0;

    for(int j = 0; j < vertices; j++){
        if(matrix[node1-1][j] != 0){
            grau++;
        }
    }

    return grau;

}

int grauSaida(int node1, int **matrix, int vertices){

    int grauSaida = 0;

    for(int i = 0; i < vertices; i++){
        if(matrix[i][node1-1] != 0){
            grauSaida++;
        }
    }

    return grauSaida;
    
}

int maximo(int **matrix, int vertices){

    int maximo, entrada, saida, maior = 0;
    
    for(int i = 0; i < vertices; i++){
        entrada = grauEntrada(i+1, matrix, vertices);
        saida = grauSaida(i+1, matrix, vertices);

        if(entrada>saida && entrada > maior){
                maior = entrada;
        }

        else if(saida>entrada && saida > maior){
                maior = saida;
        }
    }

    return maior;
}

int minimo(int **matrix, int vertices){

    int maximo, entrada, saida, menor = 9999;
    
    for(int i = 0; i < vertices; i++){
        entrada = grauEntrada(i+1, matrix, vertices);
        saida = grauSaida(i+1, matrix, vertices);

        if(saida>entrada && entrada < menor){
                menor = entrada;
        }

        if(entrada>saida && saida < menor){
                menor = saida;
        }
    }

    return menor;
}

bool adjacencia(int node1, int node2, int **matrix){
    
    return matrix[node1][node2] != 0 || matrix[node2][node1] != 0;

}

int regular(int **matrix, int vertices, int categoria){

    int grau = grauEntrada(1, matrix, vertices);
    
    //n orientado
    if(categoria == 0 || categoria == 2){

        for(int i = 1;i < vertices; i++){
            if(grau != grauEntrada(i+1, matrix, vertices)){
                return 0;
            }
        }

        return 1;
    }

    //orientado

    int grauS = grauSaida(1, matrix, vertices);

    for(int i = 1; i < vertices; i++){
        if(grau != grauEntrada(i+1, matrix, vertices) || grauS != grauSaida(i+1, matrix, vertices)){
            return 0;
        }
    }

    return 1;

}

int completo(int **matrix, int vertices, int categoria){

    if(regular(matrix, vertices, categoria) == 0){
        return 0;
    }

    int grau = maximo(matrix, vertices);

    return grau == vertices - 1;
   
}

int main(){

int vertices, arestas, categoria;

scanf("%d", &vertices);
scanf("%d", &arestas);
scanf("%d", &categoria);

int **matrix;

matrix = malloc(vertices * sizeof(int*));

for(int i = 0; i < vertices; i++){
    matrix[i] = malloc(vertices * sizeof(int));
}

for(int i = 0; i < vertices; i++){
    for(int j = 0; j < vertices; j++){
        matrix[i][j] = 0;
    }
}

int node1, node2;

for(int i = 0; i < arestas; i++){
    scanf("%d %d", &node1, &node2);

    if (categoria == 0){
        matrix[node1-1][node2-1] = 1;
        matrix[node2-1][node1-1] = 1;
    }

    if (categoria == 1){
        matrix[node1-1][node2-1] = 1;
    }
    
    int peso1, peso2;

    if(categoria == 2){
        scanf("%d %d", &peso1, &peso2);

        matrix[node1-1][node2-1] = peso1;
        matrix[node2-1][node1-1] = peso2;
    }

    if(categoria == 3){
        scanf("%d", &peso1);
        matrix[node1-1][node2-1] = peso1;
    }
}

