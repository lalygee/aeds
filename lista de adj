void removerVertice(Grafo *g, int vertice, int categoria){

    for(int i = 0; i < g->numVertices; i++){
        removerAresta(g, i+1, vertice, categoria);
    }

    Node *temp = g->listaAdj[vertice-1];

    while(temp){
        Node *aux = temp;
        temp = temp->next;
        free(aux);
    }

    g->listaAdj[vertice-1] = NULL;


