    void removerDaLista(Grafo *g, int n1, int n2){
        Node *temp = g->listaAdj[node1-1];
        Node *ant = null;

        while(temp){
            if(temp->vertice == node2){
                if(ant == null){
                    g->listaAdj[node1-1] = temp->next;
                }
