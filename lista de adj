#include <stdio.h>
#include <stdlib.h>

typedef struct Node{
    int peso;
    struct Node *next;
}Node;

typedef struct Grafo{
    int numVertices;
    struct Node **listaAdj;
}Grafo;

Node createNode(int valor){
    Node *n = malloc(sizeof(Node));
    n->peso = valor;
    n->next = NULL;

    return n;
}

listaAdj createList(int vertices){

    Grafo *graph = malloc(sizeof(Grafo));
    graph->numVertices = vertices;
    graph->listaAdj = malloc(vertices * sizeof(Node));

    for(int i = 0; i < vertices; i++){
        listaAdj[i] = NULL;
    }

    return graph;
}

int main(){

    int vertices, arestas, categorias;
    
    scanf("%d", &vertices);
    scanf("%d", &arestas);
    scanf("%d", &categoria);

    listaAdj *lista = createList(vertices);

    int node1, node2;

    for(int i = 0; i < arestas; i++){

        scanf("%d %d", &node1, &node2);

        // criar no com ou sem peso
        if(categoria == 0 || categoria == 1){
            node1 = createNode(0);
            node2 = createNode(0);
        }

        // não orientado
        if(categoria == 0){
            lista[node1]->next = node2;
            lista[node2]->next = node1; 
        }

        // orientado
        if(categoria == 1){
            lista[node1]->next = node2;
        }

        int peso1, peso2;
        scanf("%d %d", &peso1, &peso2);

        node1 = createNode(peso1);
        node2 = createNode(peso2);

        //não orientado com peso
        if(categoria == 2){
            lista[node1]->next = node2;
            lista[node2]->next = node1; 
        } 

        // orientado com peso
        if(categoria == 3){
            lista[node1] = node2;
        }
    }

}

